<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>ระบบจัดก๊วนตีแบด — พร้อมประวัติ & แก้เฉพาะคน</title>
<style>
	
  :root{--bg:#f5f7fb;--card:#fff;--muted:#6b7280;--accent:#2563eb}
  *{box-sizing:border-box;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial}
  body{margin:0;background:var(--bg);padding:18px;color:#0f172a}
  .wrap{max-width:1100px;margin:0 auto}
  header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
  h1{font-size:20px;margin:0}
  .card{background:var(--card);padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(2,6,23,0.06);margin-bottom:12px}
  .row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  input[type="text"], select{padding:8px;border-radius:8px;border:1px solid #e6eef8}
  button{padding:8px 10px;border-radius:8px;border:0;background:var(--accent);color:white;cursor:pointer}
  button.gray{background:#6b7280}
  button.red{background:#ef4444}
  table{width:100%;border-collapse:collapse;margin-top:10px;font-size:14px}
  th,td{padding:8px;border-bottom:1px solid #eef2f7;text-align:left;vertical-align:middle}
  th.play, td.play{width:34px;text-align:center}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-top:10px}
  .court{padding:12px;border-radius:10px;background:#fbfdff;border:1px solid #e6f0ff}
  .muted{color:var(--muted);font-size:13px}
  .small{font-size:12px}
  .players{margin-top:8px}
  .player-line{display:flex;align-items:center;justify-content:space-between;padding:6px 0}
  .pending{background:#fffaf0;padding:8px;border-radius:8px;border:1px solid #f5e4c9;margin-top:8px}
  .history-list{max-height:200px;overflow:auto;margin-top:8px;border-top:1px dashed #e6eef8;padding-top:8px}
  @media(max-width:640px){th,td{font-size:12px} h1{font-size:18px}#membersTable thead th:nth-child(2),
  #membersTable tbody td:nth-child(2) {
    display: table-cell;
    min-width: 120px; /* หรือปรับตามต้องการ */
  }}

	
	
</style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>ระบบจัดก๊วนตีแบด</h1>
      <div class="muted small">เก็บข้อมูลในเครื่อง (localStorage)</div>
    </header>

    <!-- MEMBERS -->
    <section class="card" id="membersCard">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
        <div>
          <strong>ตารางสมาชิก</strong><div class="muted small">คลิกแก้ชื่อหรือระดับมือได้ตลอด</div>
        </div>
        <div class="row">
          <input id="inputName" type="text" placeholder="ชื่อสมาชิก" />
          <select id="inputSkill">
  <option>เบามาก</option>
  <option>เบา</option>
  <option selected>กลาง</option>
  <option>กลางหนัก</option>
  <option>หนัก</option>
</select>
          <button id="btnAdd">เพิ่มสมาชิก</button>
          <button id="btnReset" class="red">รีเซ็ตทั้งหมด</button>
        </div>
      </div>

      <div style="overflow:auto;margin-top:12px">
        <table id="membersTable">
          <thead>
<tr>
  <th style="width:46px">ลำดับ</th>
  <th style="width:100px">ชื่อ</th>
  <th style="width:120px">ระดับมือ</th>
  <th style="width:90px">สถานะ</th>
  <th style="width:20px">1</th>
  <th style="width:20px">2</th>
  <th style="width:20px">3</th>
  <th style="width:20px">4</th>
  <th style="width:20px">5</th>
  <th style="width:20px">6</th>
  <th style="width:20px">7</th>
  <th style="width:20px">8</th>
  <th style="width:20px">9</th>
  <th style="width:80px">จัดการ</th>
</tr>
</thead>
          <tbody id="membersTbody"></tbody>
        </table>
      </div>
    </section>

    <!-- COURTS -->
    <section class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
        <div>
          <strong>สนาม</strong><div class="muted small">เพิ่มสนามได้หลายสนาม</div>
        </div>
        <div class="row">
          <input id="inputCourt" type="text" placeholder="ชื่อสนาม (เช่น Court 1)" />
          <button id="btnAddCourt">เพิ่มสนาม</button>
        </div>
      </div>

      <div class="grid" id="courtsGrid"></div>
    </section>

    <!-- HISTORY -->
    <section class="card">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <strong>ประวัติการจับคู่ (ใครเคยคู่กับใคร)</strong>
          <div class="muted small">บันทึกเมื่อกดตกลงยืนยันสนาม — ใช้เพื่อเลี่ยงจับคู่ซ้ำ</div>
        </div>
        <div class="row">
          <button id="btnExport" class="gray">Export CSV</button>
          <button id="btnClearHistory" class="red">ลบประวัติ</button>
        </div>
      </div>

      <div class="history-list" id="historyList"></div>
    </section>

    <footer style="margin-top:8px;color:#475569;font-size:13px">หมายเหตุ: ระบบพยายามเลือกผู้เล่นที่เล่นน้อยสุดก่อน และหลีกเลี่ยงการจับคู่ซ้ำ หากหาไม่ได้จะแจ้งให้ทราบ</footer>
  </div>

<script>
/* Data structures:
  members: [{id,name,skill,plays:[bool*9]}]
  courts: [{id,name,players:[], pending:null}] // players length 4 when confirmed
  pairHistory: {"id|id":count}
  matchHistory: [{a:id,b:id,t:timestamp}] // store each teammate pair occurrence
*/
const SKILL_VALUES = { 'เบามาก': 1, 'เบา': 2, 'กลาง': 3, 'กลางหนัก': 4, 'หนัก': 5 };
function uid(){ return Math.random().toString(36).slice(2,9); }
function load(k){ try{ return JSON.parse(localStorage.getItem(k)); }catch(e){ return null; } }
function save(k,v){ localStorage.setItem(k, JSON.stringify(v)); }

let members = load('bm_members') || [];
let courts = load('bm_courts') || [];
let pairHistory = load('bm_pairHistory') || {}; // counts per pair
let matchHistory = load('bm_matchHistory') || []; // list of {a,b,t}

function saveAll(){ save('bm_members', members); save('bm_courts', courts); save('bm_pairHistory', pairHistory); save('bm_matchHistory', matchHistory); }

const membersTbody = document.getElementById('membersTbody');
const courtsGrid = document.getElementById('courtsGrid');
const historyList = document.getElementById('historyList');

function renderMembers(){
  membersTbody.innerHTML = '';
  if(members.length === 0){
    membersTbody.innerHTML = '<tr><td colspan="14" style="padding:18px;text-align:center;color:#64748b">ยังไม่มีสมาชิก — เพิ่มสมาชิกเพื่อเริ่มใช้งาน</td></tr>';
    return;
  }

  members.forEach((m, idx) => {
    m.plays = m.plays || Array(9).fill(false);
    if(!m.status) m.status = 'ยังไม่มา';

    const tr = document.createElement('tr');

    // ลำดับ
    const tdIdx = document.createElement('td');
    tdIdx.textContent = idx + 1;
    tr.appendChild(tdIdx);

    // ชื่อ
    const tdName = document.createElement('td');
    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.value = m.name;
    nameInput.style.width = '100%';
    nameInput.onchange = () => {
      m.name = nameInput.value.trim();
      saveAll();
      renderCourts();
      renderHistory();
    };
    tdName.appendChild(nameInput);
    tr.appendChild(tdName);

    // ระดับมือ
    const tdSkill = document.createElement('td');
    const selSkill = document.createElement('select');
    ['เบามาก','เบา','กลาง','กลางหนัก','หนัก'].forEach(s => {
      const op = document.createElement('option');
      op.value = s;
      op.textContent = s;
      if(s === m.skill) op.selected = true;
      selSkill.appendChild(op);
    });
    selSkill.onchange = () => { m.skill = selSkill.value; saveAll(); };
    tdSkill.appendChild(selSkill);
    tr.appendChild(tdSkill);

    // สถานะ
const tdStatus = document.createElement('td');
const selStatus = document.createElement('select');
function updateStatusColor(selectEl) {
  if(selectEl.value === 'มาแล้ว'){
    selectEl.style.backgroundColor = '#22c55e';
    selectEl.style.color = 'white';
  } else {
    selectEl.style.backgroundColor = '#ef4444';
    selectEl.style.color = 'white';
  }
}
['ยังไม่มา','มาแล้ว'].forEach(s => {
  const op = document.createElement('option');
  op.value = s;
  op.textContent = s;
  if(m.status === s) op.selected = true;
  selStatus.appendChild(op);
});
updateStatusColor(selStatus);
selStatus.onchange = () => {
  m.status = selStatus.value;
  updateStatusColor(selStatus);
  saveAll();
  renderMembers();
};
tdStatus.appendChild(selStatus);
tr.appendChild(tdStatus);

    // plays 1-9
    for(let i = 0; i < 9; i++){
      const td = document.createElement('td');
      td.className = 'play';
      const chk = document.createElement('input');
      chk.type = 'checkbox';
      chk.checked = !!m.plays[i];
      chk.onchange = () => { m.plays[i] = chk.checked; saveAll(); };
      td.appendChild(chk);
      tr.appendChild(td);
    }

    // จัดการ
    const tdManage = document.createElement('td');
    const btnDel = document.createElement('button');
    btnDel.textContent = 'ลบ';
    btnDel.className = 'red';
    btnDel.onclick = () => {
      if(!confirm('ลบสมาชิกนี้?')) return;
      courts.forEach(c => {
        if(c.players && c.players.includes(m.id)) c.players = c.players.filter(x => x !== m.id);
        if(c.pending){
          const flat = c.pending.teams.flat();
          if(flat.includes(m.id)) c.pending = null;
        }
      });
      members = members.filter(x => x.id !== m.id);
      saveAll();
      renderAll();
    };
    tdManage.appendChild(btnDel);
    tr.appendChild(tdManage);

    membersTbody.appendChild(tr);
  });
}

function renderCourts(){
  courtsGrid.innerHTML = '';
  if(courts.length === 0){
    courtsGrid.innerHTML = '<div style="grid-column:1/-1;padding:10px;background:#fff;border-radius:8px;border:1px dashed #e6edf8;text-align:center;color:#64748b">ยังไม่มีสนาม — เพิ่มสนามเพื่อเริ่มจัด</div>';
    return;
  }
  courts.forEach(court => {
    const el = document.createElement('div'); el.className='court';
    const top = document.createElement('div'); top.style.display='flex'; top.style.justifyContent='space-between'; top.style.alignItems='center';
    const title = document.createElement('div'); title.innerHTML = `<strong>${escapeHtml(court.name)}</strong>`;
    const controls = document.createElement('div');

    const btnArrange = document.createElement('button'); btnArrange.textContent='จัดคนลง'; btnArrange.onclick = ()=> arrangeForCourt(court.id);
    const btnManual = document.createElement('button');
    btnManual.textContent = 'จัดเอง';
    btnManual.style.backgroundColor = '#22c55e'; // green
    btnManual.onclick = () => manualAssign(court.id);
    controls.appendChild(btnManual);

    const btnEmpty = document.createElement('button'); btnEmpty.textContent='ว่าง'; btnEmpty.className='gray'; btnEmpty.onclick = ()=>{
      if(!confirm('จะเคลียร์ผู้เล่นในสนามนี้ออกใช่หรือไม่?')) return;
      court.players = []; court.pending = null; saveAll(); renderAll();
    };
    const btnRemove = document.createElement('button'); btnRemove.textContent='ลบ'; btnRemove.className='red'; btnRemove.style.marginLeft='6px';
    btnRemove.onclick = ()=>{ if(!confirm('ลบสนามนี้?')) return; courts = courts.filter(x=>x.id!==court.id); saveAll(); renderAll(); };

    controls.appendChild(btnArrange); controls.appendChild(btnEmpty); controls.appendChild(btnRemove);
    top.appendChild(title); top.appendChild(controls);
    el.appendChild(top);

    const info = document.createElement('div'); info.className='muted small'; info.style.marginTop='8px'; info.textContent='ผู้เล่นในสนาม:';
    el.appendChild(info);

    const playersBox = document.createElement('div'); playersBox.className='players';

    if(court.pending){
      // show pending with change buttons per slot
      const box = document.createElement('div'); box.className='pending';
      const heading = document.createElement('div'); heading.className='small muted'; heading.textContent='ผลการสุ่ม (ยังไม่ยืนยัน)';
      box.appendChild(heading);

      // two columns: team A and B
      const teamsRow = document.createElement('div'); teamsRow.style.display='flex'; teamsRow.style.justifyContent='space-between'; teamsRow.style.gap='8px';
      ['A','B'].forEach((t,i)=>{
        const team = document.createElement('div'); team.style.flex='1';
        const lab = document.createElement('div'); lab.className='small muted'; lab.textContent = 'ทีม ' + t;
        team.appendChild(lab);
        const member1 = court.pending.teams[i][0]; const member2 = court.pending.teams[i][1];
        [member1, member2].forEach((mid, idxMember)=>{
          const row = document.createElement('div'); row.style.display='flex'; row.style.justifyContent='space-between'; row.style.alignItems='center'; row.style.marginTop='6px';
          const nameDiv = document.createElement('div'); nameDiv.innerHTML = `<strong>${escapeHtml(getMemberName(mid))}</strong><div class="muted small">${getMemberSkill(mid)}</div>`;
          const changeBtn = document.createElement('button'); changeBtn.textContent='เปลี่ยน'; changeBtn.className='gray'; changeBtn.style.marginLeft='8px';
          changeBtn.onclick = ()=> openReplaceDialog(court.id, i, idxMember);
          row.appendChild(nameDiv); row.appendChild(changeBtn);
          team.appendChild(row);
        });
        teamsRow.appendChild(team);
      });
      box.appendChild(teamsRow);

      const btnRow = document.createElement('div'); btnRow.style.marginTop='10px'; btnRow.style.display='flex'; btnRow.style.gap='8px';
      const ok = document.createElement('button'); ok.textContent='ตกลง'; ok.onclick = ()=> confirmArrangement(court.id);
      const cancel = document.createElement('button'); cancel.textContent='ยกเลิก'; cancel.className='gray'; cancel.onclick = ()=> { court.pending = null; saveAll(); renderAll(); };
      btnRow.appendChild(ok); btnRow.appendChild(cancel);
      box.appendChild(btnRow);

      playersBox.appendChild(box);
    } else if(court.players && court.players.length === 4){
      const aName = getMemberName(court.players[0]) + ' & ' + getMemberName(court.players[1]);
      const bName = getMemberName(court.players[2]) + ' & ' + getMemberName(court.players[3]);
      const d = document.createElement('div'); d.className='player-line';
      d.innerHTML = `<div><div class="small muted">ทีม A</div><div><strong>${escapeHtml(aName)}</strong></div></div><div><div class="small muted">ทีม B</div><div><strong>${escapeHtml(bName)}</strong></div></div>`;
      playersBox.appendChild(d);
    } else {
      const d = document.createElement('div'); d.className='small muted'; d.textContent = 'ว่าง';
      playersBox.appendChild(d);
    }

    el.appendChild(playersBox);
    courtsGrid.appendChild(el);
  });
}

function renderHistory(){
  historyList.innerHTML = '';
  if(matchHistory.length === 0){
    historyList.innerHTML = '<div class="muted small">ยังไม่มีประวัติการจับคู่</div>'; return;
  }
  // build map counts per pair and show recent entries
  // We'll show as "ชื่อA - ชื่อB (ครั้ง: n) ล่าสุด: date"
  const map = {};
  matchHistory.forEach(item => {
    const key = pairKey(item.a, item.b);
    map[key] = map[key] || {a:item.a,b:item.b,count:0,last:item.t};
    map[key].count += 1;
    if(item.t > map[key].last) map[key].last = item.t;
  });
  // sort by last desc
  const rows = Object.values(map).sort((x,y)=>y.last - x.last);
  rows.forEach(r => {
    const div = document.createElement('div'); div.style.padding='6px 0'; div.style.borderBottom='1px dashed #eef2f7';
    const nameLine = document.createElement('div'); nameLine.innerHTML = `<strong>${escapeHtml(getMemberName(r.a))}</strong> — <strong>${escapeHtml(getMemberName(r.b))}</strong>`;
    const meta = document.createElement('div'); meta.className='muted small'; meta.textContent = `จำนวนครั้ง: ${r.count} · ล่าสุด: ${new Date(r.last).toLocaleString()}`;
    div.appendChild(nameLine); div.appendChild(meta); historyList.appendChild(div);
  });
}

/* Helpers */
function getMemberName(id){ const m = members.find(x=>x.id===id); return m ? m.name : '(หายไป)'; }
function getMemberSkill(id){ const m = members.find(x=>x.id===id); return m ? m.skill : ''; }
function pairKey(a,b){ return a < b ? `${a}|${b}` : `${b}|${a}`; }
function escapeHtml(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); }

/* Arrange logic */
function getAvailableMembers(){
  const inCourt = new Set(courts.flatMap(c => c.players || []).filter(Boolean));
  return members.filter(m => m.status === 'มาแล้ว' && !inCourt.has(m.id));
}

// tryMakeMatch: returns { teams:[[id,id],[id,id]], details: {a:{id},b:{id},c:{id},d:{id}} } or null
function tryMakeMatch(avail){
  if(avail.length < 4) return null;
  // compute playCount (how many true in plays)
  avail.forEach(a => a.playCount = (a.plays || []).filter(Boolean).length);
  // group by playCount asc, shuffle within
  const groups = {};
  avail.forEach(a => { groups[a.playCount] = groups[a.playCount] || []; groups[a.playCount].push(a); });
  const pcs = Object.keys(groups).map(Number).sort((a,b)=>a-b);
  const ordered = [];
  pcs.forEach(pc => {
    const arr = groups[pc].slice();
    for(let i=arr.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [arr[i],arr[j]]=[arr[j],arr[i]]; }
    ordered.push(...arr);
  });
  const n = Math.min(ordered.length, 14);
  for(let i=0;i<n;i++){
    for(let j=i+1;j<n;j++){
      for(let k=j+1;k<n;k++){
        for(let l=k+1;l<n;l++){
          const a=ordered[i], b=ordered[j], c=ordered[k], d=ordered[l];
          const sum1 = SKILL_VALUES[a.skill] + SKILL_VALUES[b.skill];
          const sum2 = SKILL_VALUES[c.skill] + SKILL_VALUES[d.skill];
          if(sum1 !== sum2) continue;
          // avoid previous pair in both teams
          const keyAB = pairKey(a.id,b.id), keyCD = pairKey(c.id,d.id);
          if((pairHistory[keyAB]||0) > 0) continue;
          if((pairHistory[keyCD]||0) > 0) continue;
          return { teams:[[a.id,b.id],[c.id,d.id]], details:{ a:{id:a.id}, b:{id:b.id}, c:{id:c.id}, d:{id:d.id} } };
        }
      }
    }
  }
  // fallback: accept minimal repeats by scoring pairHistory sum and choose minimal
  let best = null;
  for(let i=0;i<n;i++){
    for(let j=i+1;j<n;j++){
      for(let k=j+1;k<n;k++){
        for(let l=k+1;l<n;l++){
          const a=ordered[i], b=ordered[j], c=ordered[k], d=ordered[l];
          const sum1 = SKILL_VALUES[a.skill] + SKILL_VALUES[b.skill];
          const sum2 = SKILL_VALUES[c.skill] + SKILL_VALUES[d.skill];
          if(sum1 !== sum2) continue;
          const keyAB = pairKey(a.id,b.id), keyCD = pairKey(c.id,d.id);
          const score = (pairHistory[keyAB]||0) + (pairHistory[keyCD]||0);
          if(best === null || score < best.score){
            best = { teams:[[a.id,b.id],[c.id,d.id]], score, details:{ a:{id:a.id}, b:{id:b.id}, c:{id:c.id}, d:{id:d.id} } };
          }
        }
      }
    }
  }
  return best ? best : null;
}

function arrangeForCourt(courtId){
  const court = courts.find(c=>c.id===courtId);
  const avail = getAvailableMembers();
  if(avail.length < 4){ alert('ต้องมีผู้เล่นอย่างน้อย 4 คนที่ยังว่าง'); return; }
  const match = tryMakeMatch(avail);
  if(!match){ alert('ไม่พบผู้เล่นที่ตรงเงื่อนไข (ลองเพิ่มสมาชิกหรือปรับระดับมือ)'); return; }
  court.pending = match;
  saveAll(); renderAll();
}

/* Confirm arrangement: commit players -> update plays & history */
function confirmArrangement(courtId){
  const court = courts.find(c=>c.id===courtId);
  if(!court || !court.pending) return;
  const ids = court.pending.teams.flat();
  // mark plays: find first false slot and set true
  ids.forEach(id=>{
    const m = members.find(x=>x.id === id);
    if(m){
      m.plays = m.plays || Array(9).fill(false);
      const idx = m.plays.findIndex(v=>v===false);
      if(idx >= 0) m.plays[idx] = true;
    }
  });
  // record pairHistory & matchHistory for each team (teammates)
  const [teamA, teamB] = court.pending.teams;
  recordPair(teamA[0], teamA[1]); recordPair(teamB[0], teamB[1]);
  // save matchHistory entries with timestamp
  const t = Date.now();
  matchHistory.push({a:teamA[0], b:teamA[1], t}); matchHistory.push({a:teamB[0], b:teamB[1], t});
  court.players = ids;
  court.pending = null;
  saveAll(); renderAll();
}

function recordPair(a,b){
  const key = pairKey(a,b);
  pairHistory[key] = (pairHistory[key] || 0) + 1;
}

/* Replacement dialog: replace one position in pending */
function openReplaceDialog(courtId, teamIndex, memberIndex){
  const court = courts.find(c=>c.id===courtId);
  if(!court || !court.pending) return;
  const inCourt = new Set(courts.flatMap(c => c.players || []).filter(Boolean));
  const pendingIds = new Set(court.pending.teams.flat());
  const currentId = court.pending.teams[teamIndex][memberIndex];

  const candidates = members.filter(m => m.id !== currentId && !inCourt.has(m.id) && !pendingIds.has(m.id));
  if(candidates.length === 0){
    alert('ไม่มีสมาชิกที่สามารถเปลี่ยนได้');
    return;
  }

  // สร้าง modal overlay
  const modal = document.createElement('div');
  modal.style = `
    position: fixed; top:0; left:0; right:0; bottom:0;
    background: rgba(0,0,0,0.5);
    display:flex; justify-content:center; align-items:center;
    z-index: 9999;
  `;

  // กล่องเลือกสมาชิก
  const box = document.createElement('div');
  box.style = `
    background: white; padding: 20px; border-radius: 12px; min-width: 280px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  `;

  const label = document.createElement('div');
  label.textContent = 'เลือกสมาชิกที่ต้องการเปลี่ยน:';
  label.style.marginBottom = '10px';
  box.appendChild(label);

  const select = document.createElement('select');
  select.style.width = '100%';
  candidates.forEach(c => {
    const opt = document.createElement('option');
    opt.value = c.id;
    opt.textContent = c.name;
    select.appendChild(opt);
  });
  box.appendChild(select);

  // ปุ่มยืนยันและยกเลิก
  const btnRow = document.createElement('div');
  btnRow.style.marginTop = '15px';
  btnRow.style.textAlign = 'right';

  const btnCancel = document.createElement('button');
  btnCancel.textContent = 'ยกเลิก';
  btnCancel.style.marginRight = '10px';
  btnCancel.onclick = () => document.body.removeChild(modal);

  const btnOk = document.createElement('button');
  btnOk.textContent = 'ตกลง';
  btnOk.onclick = () => {
    const chosenId = select.value;
    court.pending.teams[teamIndex][memberIndex] = chosenId;
    saveAll();
    renderAll();
    document.body.removeChild(modal);
  };

  btnRow.appendChild(btnCancel);
  btnRow.appendChild(btnOk);
  box.appendChild(btnRow);

  modal.appendChild(box);
  document.body.appendChild(modal);
}

/* Utility: get member by name for quick replacement (we used prompt above) */
/* You can later replace prompt UI with a nicer select/modal - this version keeps code simple */


function manualAssign(courtId){
  const court = courts.find(c=>c.id===courtId);
  const inCourt = new Set(courts.flatMap(c => c.players || []).filter(Boolean));
  const avail = members.filter(m => !inCourt.has(m.id));
  if(avail.length < 4){ alert('ต้องมีผู้เล่นอย่างน้อย 4 คนที่ยังว่าง'); return; }

  // Modal
  const modal = document.createElement('div');
  modal.style = `
    position: fixed; top:0; left:0; right:0; bottom:0;
    background: rgba(0,0,0,0.5);
    display:flex; justify-content:center; align-items:center;
    z-index: 9999;
  `;
  const box = document.createElement('div');
  box.style = `
    background: white; padding: 20px; border-radius: 12px; min-width: 300px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  `;
  const title = document.createElement('div');
  title.textContent = 'เลือกผู้เล่น 4 คน';
  title.style.marginBottom = '10px';
  box.appendChild(title);

  const selects = [];
  for(let i=0;i<4;i++){
    const sel = document.createElement('select');
    sel.style.width = '100%';
    sel.style.marginBottom = '8px';
    avail.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.name;
      sel.appendChild(opt);
    });
    selects.push(sel);
    box.appendChild(sel);
  }

  const btnRow = document.createElement('div');
  btnRow.style.textAlign = 'right';
  const btnCancel = document.createElement('button');
  btnCancel.textContent = 'ยกเลิก';
  btnCancel.style.marginRight = '10px';
  btnCancel.onclick = ()=> document.body.removeChild(modal);
  const btnOk = document.createElement('button');
  btnOk.textContent = 'ตกลง';
  btnOk.onclick = ()=>{
    const chosen = selects.map(s=>s.value);
    if(new Set(chosen).size < 4){ alert('ห้ามเลือกชื่อซ้ำ'); return; }
    court.pending = { teams: [[chosen[0], chosen[1]], [chosen[2], chosen[3]]] };
    saveAll(); renderAll();
    document.body.removeChild(modal);
  };
  btnRow.appendChild(btnCancel);
  btnRow.appendChild(btnOk);
  box.appendChild(btnRow);
  modal.appendChild(box);
  document.body.appendChild(modal);
}


function renderAll(){ renderMembers(); renderCourts(); renderHistory(); }

/* Export CSV for history (pair counts) */
function exportCSV(){
  // create CSV: nameA,nameB,count,lastDate
  const map = {};
  matchHistory.forEach(item => {
    const key = pairKey(item.a,item.b);
    map[key] = map[key] || {a:item.a,b:item.b,count:0,last:0};
    map[key].count += 1; if(item.t > map[key].last) map[key].last = item.t;
  });
  let csv = 'nameA,nameB,count,lastDate\\n';
  Object.values(map).forEach(r => {
    csv += `"${getMemberName(r.a)}","${getMemberName(r.b)}",${r.count},"${new Date(r.last).toLocaleString()}"\\n`;
  });
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'pair_history.csv'; a.click(); URL.revokeObjectURL(url);
}

/* Buttons wiring */
document.getElementById('btnAdd').onclick = ()=>{
  const nameEl = document.getElementById('inputName'); const skillEl = document.getElementById('inputSkill');
  const name = (nameEl.value || '').trim(); const skill = skillEl.value;
  if(!name) return alert('กรุณากรอกชื่อ');
  members.push({ id: uid(), name, skill, plays: Array(9).fill(false), status: 'ยังไม่มา' });
  nameEl.value = ''; skillEl.value = 'กลาง';
  saveAll(); renderAll();
};

document.getElementById('btnReset').onclick = ()=>{
  if(!confirm('รีเซ็ตข้อมูลทั้งหมด (สมาชิก, สนาม, ประวัติ)?')) return;
  members = []; courts = []; pairHistory = {}; matchHistory = []; saveAll(); renderAll();
};

document.getElementById('btnAddCourt').onclick = ()=>{
  const el = document.getElementById('inputCourt'); const name = (el.value || '').trim() || ('Court ' + (courts.length+1));
  courts.push({ id: uid(), name, players: [], pending: null });
  el.value = ''; saveAll(); renderAll();
};

document.getElementById('btnExport').onclick = exportCSV;
document.getElementById('btnClearHistory').onclick = ()=>{
  if(!confirm('จะลบประวัติการจับคู่ทั้งหมด ใช่หรือไม่?')) return;
  pairHistory = {}; matchHistory = []; saveAll(); renderAll();
};

/* initial load */
renderAll();

/* Expose for debugging in console if needed */
window._bm = { members, courts, pairHistory, matchHistory, renderAll };

